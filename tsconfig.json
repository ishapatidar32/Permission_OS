{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    
  },
  "include": [
    "apps/gateway/**/*",
    "apps/demo-upstream/**/*",
    "packages/**/*",
    "tests/**/*",
    "scripts/**/*"
  ]
}
